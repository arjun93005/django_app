# Copy to .env for local (non-Docker) development:  cp .env.example .env
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-secret
DJANGO_DEBUG=true
DATABASE_URL=postgres://pricelens:pricelens@localhost:5432/pricelens

# Optional: leave empty to use the in-process LocMem cache
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/1

# Connection handling (pick one; see config/settings/base.py)
DB_POOL=false
USE_PGBOUNCER=false

# Crawler
CRAWLER_RESPECT_ROBOTS=true
SELENIUM_HEADLESS=true
# Empty = start a local Chrome via Selenium Manager
SELENIUM_REMOTE_URL=
DEMO_SHOP_URL=http://127.0.0.1:5050
